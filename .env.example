# ============================================
# EMPIRE HYBRID LOUNGE - ENVIRONMENT VARIABLES
# ============================================
# Copy this file to .env.local and fill in the values

# ============================================
# SITE CONFIGURATION
# ============================================
NEXT_PUBLIC_SITE_URL=https://your-domain.com
NODE_ENV=development

# ============================================
# SUPABASE CONFIGURATION
# ============================================
# Get these from your Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-key

# Secret key for server-side operations (NEVER expose this)
SUPABASE_SECRET_KEY=your-service-role-key

# ============================================
# BUSINESS CONFIGURATION
# ============================================
BUSINESS_TIMEZONE=Africa/Douala

# ============================================
# PAYMENT PROVIDER CONFIGURATION
# ============================================
# Supported providers: campay, monetbil, sandbox
PAYMENT_PROVIDER=sandbox

# CamPay Configuration (https://docs.campay.net/)
PAYMENT_API_BASE_URL=https://api.campay.net/api
PAYMENT_API_USERNAME=
PAYMENT_API_PASSWORD=
PAYMENT_WEBHOOK_SECRET=

# Monetbil Configuration (https://www.monetbil.com/)
MONETBIL_API_KEY=
MONETBIL_WEBHOOK_SECRET=

# ============================================
# QR CODE SECURITY
# ============================================
# Random string used to pepper token hashing
QR_TOKEN_PEPPER=change-this-to-a-random-string-at-least-32-chars

# Secret for signing pass tokens
QR_SIGNING_SECRET=change-this-to-another-random-string

# ============================================
# PUSH NOTIFICATIONS (VAPID)
# ============================================
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@your-domain.com

# ============================================
# CRON JOB SECURITY
# ============================================
# Secret for authenticating cron job requests
CRON_SECRET=change-this-to-a-random-secret

# ============================================
# RATE LIMITING (Optional - Redis)
# ============================================
RATE_LIMIT_REDIS_URL=redis://localhost:6379
RATE_LIMIT_REDIS_TOKEN=

# ============================================
# ERROR MONITORING
# ============================================
# Optional: Sentry or other error tracking
ERROR_MONITORING_DSN=

# ============================================
# VERIFICATION
# ============================================
# Validate all required environment variables on startup
